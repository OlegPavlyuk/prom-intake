# Coordinator app configuration (Vite). Non-secret build/runtime vars only.
# Copy to `.env` (gitignored) or set in your shell / hosting env.
#
# Base URL of the Medplum server the coordinator authenticates against.
# Defaults to the local docker-compose Medplum when unset.
VITE_MEDPLUM_BASE_URL=http://localhost:8103/
