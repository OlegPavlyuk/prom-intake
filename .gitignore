# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Dev-only Medplum login credentials (npm run medplum:dev-user)
.dev-user.json

# Hosted deploy (scripts/deploy-hosted.ts): generated secrets + staging + tarballs.
# The rendered medplum.config.json holds the super-admin password; never commit.
infra/gcp/.deploy-secrets.json
infra/gcp/.deploy/
infra/gcp/*.tgz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.swp
Thumbs.db

# Prototype scratch (throwaway prototype branches keep their own files)
.scratch/tmp/

# Terraform (infra/gcp) - never commit state, provider plugins, or real tfvars
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
