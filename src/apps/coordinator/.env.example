# Coordinator app configuration (Vite). Non-secret build/runtime vars only.
# Copy to `.env` (gitignored) or set in your shell / hosting env.
#
# Base URL of the Medplum server the coordinator authenticates against.
# Defaults to the local docker-compose Medplum when unset.
VITE_MEDPLUM_BASE_URL=http://localhost:8103/

# Base URL of the Patient completion page (#16, a separate Vite bundle), used to
# assemble the patient-facing Access-link URL from an issued token. The coordinator
# is the delivery layer (ADR-0010); the token is minted by the Access-link module.
# Defaults to the local dev patient app when unset.
VITE_PATIENT_APP_BASE_URL=http://localhost:3001/
