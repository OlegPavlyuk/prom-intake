# Real-Medplum test project credentials for the integration harness (ADR-0008).
# Copy to `.env` (gitignored) or export in your shell / CI secrets.
#
# Local docker-compose Medplum: `npm run medplum:provision` writes these for you.
# Hosted Medplum: create a ClientApplication in your test project and paste its
# id/secret here. See docs/architecture/infrastructure.md.
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
